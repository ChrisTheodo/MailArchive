{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information",
      "MailArchive": "Information"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mailarchive;Username=postgres;Password=YOUR_LOCAL_PASSWORD;Include Error Detail=true"
  },

  "MailArchive": {
    "MaxPageSize": 100,
    "EnableAuditLogs": true,
    "MaxPstUploadSizeMb": 1000,
    "PstParserProvider": "Mock"
  },

  "Jwt": {
    "Key": "CHANGE_THIS_DEVELOPMENT_SECRET_KEY_1234567890",
    "Issuer": "MailArchive.API",
    "Audience": "MailArchive.Client",
    "ExpiresMinutes": 60
  }
}